# Discord bot token (required) - https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Discord server (guild) ID (required) - Scheduled Events are guild-scoped
GUILD_ID=123456789012345678

# How often to poll content sources for new items (minutes)
POLL_INTERVAL_MINUTES=15

# How often to check for scheduled events that need to be auto-started (minutes)
EVENT_CHECK_INTERVAL_MINUTES=2

# Content older than this is never posted or turned into an event, even the
# first time it's seen (e.g. an old video still sitting in a channel's
# recent-videos window)
MAX_CONTENT_AGE_DAYS=30

# Nintendo news page URL
NINTENDO_NEWS_URL=https://www.nintendo.com/us/whatsnew/

# Path to the franchise registry
FRANCHISES_CONFIG_PATH=gamenews/franchises.yaml

# Path to the SQLite dedup/event-tracking database
DB_PATH=data/gamenews.sqlite3

# Legacy flat-JSON dedup file, imported once into the new database if present
LEGACY_SEEN_POSTS_PATH=data/seen_posts.json
