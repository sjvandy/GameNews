# Discord bot token (required) - https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Discord channel ID to post updates in (required)
CHANNEL_ID=123456789012345678

# How often to poll for new content (minutes)
POLL_INTERVAL_MINUTES=15

# YouTube channel ID for Nintendo's channel
YOUTUBE_CHANNEL_ID=UCGIY_O-8vW4rfX98KlMkvRg

# Nintendo news page URL
NINTENDO_NEWS_URL=https://www.nintendo.com/us/whatsnew/

# Instagram settings (fragile - may break without notice)
ENABLE_INSTAGRAM=true
INSTAGRAM_USERNAME=nintendoamerica

# Path to the dedup state file
SEEN_POSTS_PATH=data/seen_posts.json
